APP_ENV=development

# HTTP
# Prefer PORT for platform/container deploys. HTTP_ADDRESS remains supported for existing VPS deploys.
# PORT=8080
HTTP_ADDRESS=:8080
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=20s

# SaaS database and auth
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/evolution_saas?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
JWT_SECRET=change-me
JWT_TTL=24h
JWT_REFRESH_TTL=168h

# Platform-level security (Fase 1 hardening)
# PLATFORM_API_KEY gates agency-wide operations such as POST /tenant.
# Falls back to GLOBAL_API_KEY below when unset. Required (>=16 chars) in production.
PLATFORM_API_KEY=
# Comma-separated browser origins allowed to send credentialed cross-origin
# requests. Leave empty for same-origin only. Example:
# CORS_ALLOWED_ORIGINS=https://fmxevolution.fmxaiflows.online,https://panel.fmxaiflows.online
CORS_ALLOWED_ORIGINS=

# SaaS workers and rate limits
BROADCAST_WORKERS=4
BROADCAST_QUEUE_BATCH_SIZE=8
BROADCAST_RATE_PER_SECOND=2
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_MESSAGES_PER_MINUTE=60
RATE_LIMIT_BROADCAST_PER_HOUR=120
RATE_LIMIT_WEBHOOK_CALLS_PER_MINUTE=120
# Brute-force protection: max login/refresh attempts per IP per minute.
RATE_LIMIT_LOGIN_PER_MINUTE=10

# AI outbound reply generation
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT=15s
AI_WORKERS=2
AI_MEMORY_LIMIT=12

# Legacy runtime bridge (required for QR/connect/status/webhook sync against the WhatsApp engine)
POSTGRES_AUTH_DB=postgresql://postgres:postgres@localhost:5432/evogo_auth?sslmode=disable
POSTGRES_USERS_DB=postgresql://postgres:postgres@localhost:5432/evogo_users?sslmode=disable
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=evogo_users
GLOBAL_API_KEY=change-me
CLIENT_NAME=evolution
OS_NAME=Linux
CONNECT_ON_STARTUP=false
WEBHOOK_FILES=true
WEBHOOK_URL=
DEBUG_ENABLED=false
LOG_TYPE=console
LOG_DIRECTORY=./logs
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30
LOG_COMPRESS=true

# Legacy runtime event backends
AMQP_URL=
AMQP_GLOBAL_ENABLED=false
AMQP_GLOBAL_EVENTS=
AMQP_SPECIFIC_EVENTS=
NATS_URL=
NATS_GLOBAL_ENABLED=false
NATS_GLOBAL_EVENTS=
EVENT_IGNORE_GROUP=false
EVENT_IGNORE_STATUS=false

# Legacy runtime media and helpers
MINIO_ENABLED=false
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
MINIO_USE_SSL=false
MINIO_REGION=
API_AUDIO_CONVERTER=
API_AUDIO_CONVERTER_KEY=
QRCODE_MAX_COUNT=5
CHECK_USER_EXISTS=true

# Optional proxy
PROXY_HOST=
PROXY_PORT=
PROXY_USERNAME=
PROXY_PASSWORD=

# Optional WhatsApp version pinning
WHATSAPP_VERSION_MAJOR=
WHATSAPP_VERSION_MINOR=
WHATSAPP_VERSION_PATCH=

# Dev-only bootstrap behavior
RESET_ADMIN_PASSWORD=false
